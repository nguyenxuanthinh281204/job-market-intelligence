# Cổng PostgreSQL ánh xạ ra máy host (dùng 5433 để tránh đụng cổng 5432 đang chạy sẵn trên máy)
POSTGRES_PORT=5433

# Cấu hình kết nối PostgreSQL khi chạy từ máy host
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/job_crawl

# Cấu hình lịch chạy tự động mỗi ngày (Giờ Việt Nam)
TIMEZONE=Asia/Ho_Chi_Minh
CRAWL_CRON_HOUR=8
CRAWL_CRON_MINUTE=0
RUN_ON_STARTUP=true

# Nguồn thu thập kích hoạt (vietnamworks, topdev, topcv, itviec)
ENABLED_SOURCES=vietnamworks,topdev,itviec,topcv
REQUEST_DELAY_SEC=1.5

# Cấu hình Playwright tự động lật trang ngầm cho ITviec & TopCV
USE_PLAYWRIGHT=true
PLAYWRIGHT_HEADLESS=true

# Cấu hình Crawler VietnamWorks
VNW_MAX_PAGES=5
VNW_PAGE_SIZE=50
VNW_REQUEST_DELAY_SEC=1.5
VNW_KEYWORDS=Developer,Software Engineer,Data Engineer,DevOps,Backend,Frontend,Fullstack,AI Engineer,QA QC

# Cấu hình số trang cào cho TopDev / TopCV / ITviec
TOPDEV_MAX_PAGES=5
TOPDEV_PAGE_SIZE=30
TOPCV_MAX_PAGES=3
ITVIEC_MAX_PAGES=3
